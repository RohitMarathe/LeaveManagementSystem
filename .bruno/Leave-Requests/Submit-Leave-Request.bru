meta {
  name: Submit Leave Request
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/LeaveRequest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "employeeId": {{employeeId}},
    "leaveType": "Annual",
    "startDate": "2026-12-01",
    "endDate": "2026-12-03",
    "reason": "Bruno API integration test"
  }
}

assert {
  res.status: 201
  res.body.isSuccess: true
}
